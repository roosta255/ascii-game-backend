LOCK_DECL(KEY_KEEPER_OPEN,       false, ActivatorChestLockKey,  ({TRAIT_DOOR_KEEPER, TRAIT_LOCK_OPEN, TRAIT_DOOR_KEYED, TRAIT_KEYABLE, TRAIT_KEY_TAKEABLE}))
