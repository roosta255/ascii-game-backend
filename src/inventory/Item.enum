// ITEM_DECL(name_, stacks_, activator_, traits_)
// ITEM_CARRY_MODIFIER_DECL({{req}, {rest}, {set}, {clr}})

ITEM_DECL(UNALLOCATED,   0, iActivator, ({ TRAIT_NIL }))  // slot not owned by any character
ITEM_DECL(NIL,           0, iActivator, ({ TRAIT_NIL }))
ITEM_DECL(KEY,           9, iActivator, ({ TRAIT_ITEM_TRANSFERABLE, TRAIT_ITEM_KEY, TRAIT_PICKPOCKETABLE }))
ITEM_DECL(CUBE_AWAKENED, 1, iActivator, ({ TRAIT_ITEM_TRANSFERABLE, TRAIT_ITEM_CUBE }))
ITEM_DECL(CUBE_DORMANT,  1, iActivator, ({ TRAIT_ITEM_TRANSFERABLE, TRAIT_ITEM_CUBE }))
ITEM_DECL(KEY_ELEVATOR,  1, iActivator, ({ TRAIT_ITEM_TRANSFERABLE, TRAIT_ITEM_KEY }))
ITEM_DECL(CRITTER,        1, iActivator, ({ TRAIT_NIL }))  // stacks field stores critterCharacterId
ITEM_DECL(CONTAINED,      1, iActivator, ({ TRAIT_NIL }))  // stacks field stores containedCharacterId
ITEM_DECL(SWORD,         1, iActivator, ({ TRAIT_ITEM_TRANSFERABLE, TRAIT_ITEM_UTILIZED }))
    ITEM_DAMAGE_TYPES_DECL( ({ DAMAGE_TYPE_SLASH, DAMAGE_TYPE_PIERCE }) )
ITEM_DECL(ARMOR,         1, iActivator, ({ TRAIT_ITEM_TRANSFERABLE, TRAIT_ITEM_ARMOR }))
ITEM_DECL(COIN,          9, iActivator, ({ TRAIT_ITEM_TRANSFERABLE, TRAIT_PICKPOCKETABLE }))
ITEM_DECL(FOOD,          9, iActivator, ({ TRAIT_ITEM_TRANSFERABLE, TRAIT_PICKPOCKETABLE }))
