// BEHAVIOR_DECL(name_)
// Optional per-state event handlers (follow immediately after BEHAVIOR_DECL).
//
// Transition hooks (fire on state entry/exit, no event matching):
//   BEHAVIOR_ON_ENTER_DECL(effects_)   — executed when FSM transitions (or defaults) into this state
//   BEHAVIOR_ON_EXIT_DECL(effects_)    — executed when FSM transitions out of this state
//
// Each event type has three role-specific slots:
//   BEHAVIOR_ON_MOVE_AS_ACTOR_DECL(config_)       — FSM owner is the mover
//   BEHAVIOR_ON_MOVE_AS_TARGET_DECL(config_)      — FSM owner is the move target
//   BEHAVIOR_ON_MOVE_AS_OBSERVER_DECL(config_)    — FSM owner is in the room but neither
//   BEHAVIOR_ON_ATTACK_AS_ACTOR_DECL(config_)
//   BEHAVIOR_ON_ATTACK_AS_TARGET_DECL(config_)
//   BEHAVIOR_ON_ATTACK_AS_OBSERVER_DECL(config_)
//   BEHAVIOR_ON_DAMAGE_AS_ACTOR_DECL(config_)
//   BEHAVIOR_ON_DAMAGE_AS_TARGET_DECL(config_)
//   BEHAVIOR_ON_DAMAGE_AS_OBSERVER_DECL(config_)
//   BEHAVIOR_ON_LOOT_AS_ACTOR_DECL(config_)
//   BEHAVIOR_ON_LOOT_AS_TARGET_DECL(config_)
//   BEHAVIOR_ON_LOOT_AS_OBSERVER_DECL(config_)
//   BEHAVIOR_ON_DEATH_AS_ACTOR_DECL(config_)
//   BEHAVIOR_ON_DEATH_AS_TARGET_DECL(config_)
//   BEHAVIOR_ON_DEATH_AS_OBSERVER_DECL(config_)
//   BEHAVIOR_ON_PICKPOCKET_AS_ACTOR_DECL(config_)
//   BEHAVIOR_ON_PICKPOCKET_AS_TARGET_DECL(config_)
//   BEHAVIOR_ON_PICKPOCKET_AS_OBSERVER_DECL(config_)
//   BEHAVIOR_ON_DEPOSIT_AS_ACTOR_DECL(config_)
//   BEHAVIOR_ON_DEPOSIT_AS_TARGET_DECL(config_)
//   BEHAVIOR_ON_DEPOSIT_AS_OBSERVER_DECL(config_)
//   BEHAVIOR_ON_ACT_DECL(config_)
//
// Effects write named ConductMemory variables (declared in ConductMemoryVariable.enum):
//   TriggerEffectSetVar{var}              scannedCharacterId      → memory[var]
//   TriggerEffectSetVarFromObj{var}       scannedObjectId         → memory[var]
//   TriggerEffectSetVarFromRoom{var}      scannedRoomId           → memory[var]
//   TriggerEffectSetVarFromContext{var}   context char id         → memory[var]
//   TriggerEffectSetVarFromSelfRoom{var}  conducting NPC's room   → memory[var]
//   TriggerEffectClearVar{var}            memory[var] = -1
//   TriggerEffectSetBehavior{state}       memory.state = state
//
// Each config_ is a TriggerConfig aggregate initialiser wrapped in ({...}).
// BEHAVIOR_ON_ENTER_DECL / BEHAVIOR_ON_EXIT_DECL take a BehaviorTransitionConfig
// aggregate initialiser: ({.effects = {...}})  — no .matches field.

BEHAVIOR_DECL(NIL)

// ─── PICKPOCKET ───────────────────────────────────────────────────────────────
//
// Flow:
//
// INIT (entered once, on spawn)
//     remember spawn room, compute return-trip door map
//         -> SEARCHING
//
// SEARCHING
//     observe victim
//         -> TRACKING
//
// TRACKING
//     follow remembered victim movement
//     observe victim
//         -> ATTEMPT
//
// ATTEMPT
//     success -> STASH_FINDING
//     failure -> TRACKING
//
// STASH_FINDING
//     find open chest
//         -> STASH_PATHING
//
// STASH_PATHING
//     compute path
//         -> STASH_TRAVERSING
//
// STASH_TRAVERSING
//     walk path
//         -> STASH_DEPOSITING
//
// STASH_DEPOSITING
//     deposit loot
//         -> PICKPOCKET_RETURN_TO_START
//
// PICKPOCKET_RETURN_TO_START
//     walk the precomputed return path back to the spawn room
//         -> PICKPOCKET_SEARCHING

BEHAVIOR_DECL(PICKPOCKET_INIT)
    // One-time setup: remember the spawn room and precompute the door map
    // that leads back to it, then fall through to searching immediately.
    BEHAVIOR_PROPOSER_DECL(({
        .priority = 3,
        .effects  = {
            TriggerEffectSetVarFromSelfRoom{CONDUCT_MEMORY_ROOM_ID},
            TriggerEffectComputeFloodPath{
                .startRoomVar    = CONDUCT_MEMORY_ROOM_ID,
                .againstNorthVar = CONDUCT_MEMORY_RETURN_DOOR_NORTH,
                .againstEastVar  = CONDUCT_MEMORY_RETURN_DOOR_EAST,
                .againstSouthVar = CONDUCT_MEMORY_RETURN_DOOR_SOUTH,
                .againstWestVar  = CONDUCT_MEMORY_RETURN_DOOR_WEST
            },
            TriggerEffectSetBehavior{BEHAVIOR_PICKPOCKET_SEARCHING}
        }
    }))

BEHAVIOR_DECL(PICKPOCKET_SEARCHING)
    // Monkey moved into a room containing a victim.
    BEHAVIOR_ON_MOVE_AS_ACTOR_DECL(({
        .effects = {
            TriggerEffectScanRoomForCharacter{
                .match = {
                    .required   = makeTraitBits({TRAIT_PICKPOCKETABLE}),
                    .restricted = makeTraitBits({TRAIT_ACTION_READY})
                },
                .onFound = {
                    TriggerEffectSetVar{CONDUCT_MEMORY_CHARACTER_ID},
                    TriggerEffectSetBehavior{BEHAVIOR_PICKPOCKET_TRACKING}
                }
            }
        }
    }))
    // Victim moved into monkey's room.
    BEHAVIOR_ON_MOVE_AS_OBSERVER_DECL(({
        .matches = { TriggerMatchCharacter{
            .source           = TriggerMatchActivationSource::Actor,
            .traitsRequired   = makeTraitBits({TRAIT_PICKPOCKETABLE}),
        } },
        .effects = {
            TriggerEffectSetVar{CONDUCT_MEMORY_CHARACTER_ID},
            TriggerEffectSetBehavior{BEHAVIOR_PICKPOCKET_ATTEMPT}
        }
    }))

BEHAVIOR_DECL(PICKPOCKET_TRACKING)
    // Remember the tracked victim's most recently observed movement direction.
    BEHAVIOR_ON_MOVE_AS_OBSERVER_DECL(({
        .matches = {
            TriggerMatchCharacterId{
                .var    = CONDUCT_MEMORY_CHARACTER_ID,
                .source = TriggerMatchCharacterSource::Actor
            }
        },
        .effects = {
            TriggerEffectSetVarFromDirection{CONDUCT_MEMORY_DIRECTION}
        }
    }))
    // Monkey moved — tracked victim is now visible; attempt steal.
    BEHAVIOR_ON_MOVE_AS_ACTOR_DECL(({
        .matches = {
            TriggerMatchCharacterVisible{.var = CONDUCT_MEMORY_CHARACTER_ID}
        },
        .effects = {
            TriggerEffectSetBehavior{BEHAVIOR_PICKPOCKET_ATTEMPT}
        }
    }))
    // Victim died.
    BEHAVIOR_ON_DEATH_AS_OBSERVER_DECL(({
        .matches = {
            TriggerMatchCharacterId{
                .var    = CONDUCT_MEMORY_CHARACTER_ID,
                .source = TriggerMatchCharacterSource::Target
            }
        },
        .effects = {
            TriggerEffectClearVar{CONDUCT_MEMORY_CHARACTER_ID},
            TriggerEffectSetBehavior{BEHAVIOR_PICKPOCKET_SEARCHING}
        }
    }))
    // Follow last known victim direction.
    BEHAVIOR_PROPOSER_DECL(({
        .priority = 3,
        .effects  = {
            TriggerEffectSetDirectionFromVar{CONDUCT_MEMORY_DIRECTION},
            TriggerEffectExecuteAction{.action = ACTION_MOVE_TO_DOOR}
        }
    }))

BEHAVIOR_DECL(PICKPOCKET_ATTEMPT)
    BEHAVIOR_PROPOSER_DECL(({
        .priority = 3,
        .effects  = {
            TriggerEffectExecuteAction{
                .action    = ACTION_PICKPOCKET,
                .targetVar = CONDUCT_MEMORY_CHARACTER_ID
            }
        }
        // .failureEffects = { TriggerEffectSetBehavior{BEHAVIOR_PICKPOCKET_TRACKING} }
    }))
    // Successful theft: scan for stash chest, store its room bits, transition to pathing.
    BEHAVIOR_ON_PICKPOCKET_AS_ACTOR_DECL(({
        .effects = {
            TriggerEffectClearVar{CONDUCT_MEMORY_CHARACTER_ID},
            TriggerEffectScanCharacters{
                .scanBuilders       = false,
                .rolesAccepted      = { ROLE_CHEST },
                .matchedRoomBitsVar = CONDUCT_MEMORY_SEARCH_TARGETS
            },
            TriggerEffectSetBehavior{BEHAVIOR_STASH_FINDING}
        }
    }))
    // Victim died.
    BEHAVIOR_ON_DEATH_AS_OBSERVER_DECL(({
        .matches = {
            TriggerMatchCharacterId{
                .var    = CONDUCT_MEMORY_CHARACTER_ID,
                .source = TriggerMatchCharacterSource::Target
            }
        },
        .effects = {
            TriggerEffectClearVar{CONDUCT_MEMORY_CHARACTER_ID},
            TriggerEffectSetBehavior{BEHAVIOR_PICKPOCKET_SEARCHING}
        }
    }))

// ─── STASH ────────────────────────────────────────────────────────────────────

BEHAVIOR_DECL(STASH_FINDING)
    // Chest room is already in SEARCH_TARGETS (set by PICKPOCKET_ATTEMPT trigger).
    // Immediately begin pathfinding toward the stash.
    BEHAVIOR_PROPOSER_DECL(({
        .priority = 3,
        .effects = {
            TriggerEffectScanCharacters{
                .scanBuilders       = false,
                .rolesAccepted      = { ROLE_CHEST },
                .matchedRoomBitsVar = CONDUCT_MEMORY_SEARCH_TARGETS
            },
            TriggerEffectSetBehavior{BEHAVIOR_STASH_PATHING}
        }
    }))

BEHAVIOR_DECL(STASH_PATHING)
    // Compute A* path toward stash room(s) in SEARCH_TARGETS; write door bits.
    // Immediately transitions to STASH_TRAVERSING on the same tick.
    BEHAVIOR_PROPOSER_DECL(({
        .priority = 3,
        .effects  = {
            TriggerEffectComputeFloodPath{
                .startBitsVar = CONDUCT_MEMORY_SEARCH_TARGETS,
                .againstNorthVar = CONDUCT_MEMORY_PATHFIND_DOOR_NORTH,
                .againstEastVar = CONDUCT_MEMORY_PATHFIND_DOOR_EAST,
                .againstSouthVar = CONDUCT_MEMORY_PATHFIND_DOOR_SOUTH,
                .againstWestVar = CONDUCT_MEMORY_PATHFIND_DOOR_WEST
            },
            TriggerEffectSetBehavior{BEHAVIOR_STASH_TRAVERSING}
        }
    }))

BEHAVIOR_DECL(STASH_TRAVERSING)
    // Follow the computed path door by door toward the stash room.
    BEHAVIOR_PROPOSER_DECL(({
        .priority = 3,
        .effects  = {
            TriggerEffectTraverseDoor{
                .doorNorthVar = CONDUCT_MEMORY_PATHFIND_DOOR_NORTH,
                .doorEastVar  = CONDUCT_MEMORY_PATHFIND_DOOR_EAST,
                .doorSouthVar = CONDUCT_MEMORY_PATHFIND_DOOR_SOUTH,
                .doorWestVar  = CONDUCT_MEMORY_PATHFIND_DOOR_WEST,
            }
        }
    }))
    // Arrived in a room containing the stash chest.
    BEHAVIOR_ON_MOVE_AS_ACTOR_DECL(({
        .effects = {
            TriggerEffectScanRoomForCharacter{
                .match   = { .roles = { ROLE_CHEST } },
                .onFound = {
                    TriggerEffectSetVar{CONDUCT_MEMORY_CHARACTER_ID},
                    TriggerEffectSetBehavior{BEHAVIOR_STASH_DEPOSITING}
                }
            }
        }
    }))

BEHAVIOR_DECL(STASH_DEPOSITING)
    BEHAVIOR_PROPOSER_DECL(({
        .priority = 3,
        .effects  = { TriggerEffectExecuteAction{.action = ACTION_DEPOSIT, .targetVar = CONDUCT_MEMORY_CHARACTER_ID} }
    }))
    BEHAVIOR_ON_DEPOSIT_AS_ACTOR_DECL(({
        .effects = {
            TriggerEffectSetBehavior{BEHAVIOR_PICKPOCKET_RETURN_TO_START}
        }
    }))

BEHAVIOR_DECL(PICKPOCKET_RETURN_TO_START)
    // Follow the return-trip door map (computed once in PICKPOCKET_INIT)
    // back toward the spawn room, stored in CONDUCT_MEMORY_ROOM_ID.
    BEHAVIOR_PROPOSER_DECL(({
        .priority = 3,
        .effects  = {
            TriggerEffectTraverseDoor{
                .doorNorthVar = CONDUCT_MEMORY_RETURN_DOOR_NORTH,
                .doorEastVar  = CONDUCT_MEMORY_RETURN_DOOR_EAST,
                .doorSouthVar = CONDUCT_MEMORY_RETURN_DOOR_SOUTH,
                .doorWestVar  = CONDUCT_MEMORY_RETURN_DOOR_WEST,
            }
        }
    }))
    // Arrived back at the spawn room; resume the search.
    BEHAVIOR_ON_MOVE_AS_ACTOR_DECL(({
        .matches = { TriggerMatchReachedTargetRoom{.var = CONDUCT_MEMORY_ROOM_ID} },
        .effects = {
            TriggerEffectSetBehavior{BEHAVIOR_PICKPOCKET_SEARCHING}
        }
    }))
